# Copy to Vercel project env vars. Never commit real secrets.

# App
HIKAYA_PUBLIC_URL=https://hikaya-nine.vercel.app
HIKAYA_ENV=production

# Database (Phase 1)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Auth (Phase 1)
AUTH_SECRET=replace-with-long-random-string
AUTH_URL=https://hikaya-nine.vercel.app

# Object storage for child assets (Phase 1–2)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=hikaya-private
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
ASSET_ENCRYPTION_KEY=

# AI providers (Phase 2–3–7)
AI_IMAGE_PROVIDER=
AI_IMAGE_API_KEY=
AI_TEXT_PROVIDER=
AI_TEXT_API_KEY=
TTS_PROVIDER=
TTS_API_KEY=

# Payments (Phase 5)
PAYMENTS_PROVIDER=stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# or regional gateway keys

# Print / shipping (Phase 6)
PRINT_PROVIDER=
PRINT_API_KEY=
SHIPPING_PROVIDER=
SHIPPING_API_KEY=

# Observability (Phase 0)
SENTRY_DSN=
